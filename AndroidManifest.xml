<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.facebook.lite" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.ss.android.ugc.trill" />
        <package android:name="com.anthropic.claude" />
        <package android:name="com.deepseek.chat" />
        <package android:name="com.google.android.apps.bard" />
        <package android:name="ai.qwenlm.chat.android" />
        <package android:name="com.google.ai.edge.gallery" />
        <package android:name="com.google.android.youtube" />
        <package android:name="deezer.android.app" />
        <package android:name="com.dywx.larkplayer" />
        <package android:name="com.darkdeveloper.kawaiianimes" />
        <package android:name="com.dvex.movp" />
        <package android:name="com.dts.freefiremax" />
        <package android:name="com.brave.browser" />
        <package android:name="com.android.calculator2" />
        <package android:name="com.android.camera" />
        <package android:name="com.sec.android.app.camera" />
        <package android:name="com.android.contacts" />
        <package android:name="com.google.android.gm" />
        <package android:name="com.google.android.googlequicksearchbox" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.sec.android.app.clockpackage" />
        <package android:name="com.google.android.deskclock" />
        <package android:name="com.android.phone" />
        <package android:name="com.google.android.dialer" />
        <package android:name="com.widgetable.theme.android" />
        <package android:name="com.mercadopago.wallet" />
        <package android:name="ar.com.personalpay" />
        <package android:name="com.didiglobal.passenger" />
        <package android:name="com.taxsee.taxsee" />
        <package android:name="com.ubercab" />
    </queries>

    <application
        android:allowBackup="true"
        android:label="AKU"
        android:supportsRtl="true"
        android:theme="@style/Theme.AKU">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".AkuAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/aku_accessibility_service_config" />
        </service>
    </application>
</manifest>
